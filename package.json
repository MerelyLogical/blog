{
	"packageManager": "pnpm@11.1.2",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "DIST_DIR=.next next dev -p 3300 --turbopack",
		"build": "next build",
		"typecheck": "tsc --noEmit",
		"testbvr": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/testbvr.ts",
		"testlift": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/testlift.ts",
		"test": "pnpm typecheck && pnpm testbvr && pnpm testlift",
		"postbuild": "pagefind --site ./out --output-path ./out/_pagefind"
	},
	"dependencies": {
		"next": "^16.4.0",
		"nextra": "^4.6.1",
		"nextra-theme-docs": "^4.6.1",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@types/node": "^25.9.9",
		"@types/react": "^19.3.0",
		"pagefind": "^1.5.2",
		"typescript": "^6.0.3"
	}
}
